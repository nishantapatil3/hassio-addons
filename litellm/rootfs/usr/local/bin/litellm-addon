#!/usr/bin/env python3
"""Start LiteLLM proxy from a user-provided configuration file."""

from __future__ import annotations

import json
import os
from pathlib import Path
import secrets
import shutil
import sys

DATA_DIR = Path(os.environ.get("LITELLM_ADDON_DATA", "/data"))
CONFIG_DIR = Path(os.environ.get("LITELLM_ADDON_CONFIG", "/config"))
CONFIG_FILE = CONFIG_DIR / "litellm.yaml"
SALT_KEY_PATH = DATA_DIR / "salt_key"
GUARDRAIL_DIR = Path("/usr/local/lib/litellm-addon")
BUNDLED_CONFIG = Path("/etc/litellm-addon/litellm.yaml")
OPTIONS_FILE = Path("/data/options.json")
OPENROUTER_API_KEY_ENV_REF = "os.environ/OPENROUTER_API_KEY"
DATABASE_URL_ENV_REF = "os.environ/DATABASE_URL"
REDIS_URL_ENV_REF = "os.environ/REDIS_URL"
DEFAULT_DATABASE_URL = (
    "postgresql://postgres:homeassistant@db21ed7f-postgres:5432/litellm"
)
LEGACY_DATABASE_URL = (
    "postgresql://postgres:homeassistant@db21ed7f-postgres-latest:5432/litellm"
)
LEGACY_REDIS_BLOCK = """  # To enable Redis response caching, uncomment and fill in your Redis URL:
  # cache: true
  # cache_params:
  #   type: redis
  #   url: redis://:password@192.168.1.10:6379/0
  #   namespace: litellm-cache
  #   ttl: 600
"""
ACTIVE_REDIS_BLOCK = """  cache: true
  cache_params:
    type: redis
    url: os.environ/REDIS_URL
    namespace: litellm-cache
    ttl: 600
"""


def get_salt_key() -> str:
    """Create a stable per-installation salt key if one does not exist."""
    if SALT_KEY_PATH.exists():
        return SALT_KEY_PATH.read_text(encoding="utf-8").strip()
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    salt_key = f"sk-salt-{secrets.token_hex(32)}"
    SALT_KEY_PATH.write_text(f"{salt_key}\n", encoding="utf-8")
    SALT_KEY_PATH.chmod(0o600)
    return salt_key


def get_options() -> dict:
    """Read HA add-on options from options.json."""
    if OPTIONS_FILE.exists():
        return json.loads(OPTIONS_FILE.read_text(encoding="utf-8"))
    return {}


def configure_environment() -> None:
    """Set the auto-generated salt key and any user-configured options."""
    os.environ["LITELLM_SALT_KEY"] = get_salt_key()
    options = get_options()
    master_key = options.get("master_key", "").strip()
    if master_key:
        os.environ["LITELLM_MASTER_KEY"] = master_key
    openrouter_api_key = options.get("openrouter_api_key", "").strip()
    if openrouter_api_key:
        os.environ["OPENROUTER_API_KEY"] = openrouter_api_key
    database_url = options.get("database_url", "").strip()
    if database_url == LEGACY_DATABASE_URL:
        database_url = database_url.replace("-postgres-latest:", "-postgres:")
    if database_url:
        os.environ["DATABASE_URL"] = database_url
    redis_url = options.get("redis_url", "").strip()
    if redis_url:
        os.environ["REDIS_URL"] = redis_url
    server_root_path = options.get("server_root_path", "").strip()
    if server_root_path:
        os.environ["SERVER_ROOT_PATH"] = server_root_path


def migrate_legacy_config() -> int:
    """Replace bundled inline defaults with values supplied by UI options."""
    contents = CONFIG_FILE.read_text(encoding="utf-8")
    legacy_openrouter_setting = "api_key: sk-your-openrouter-api-key"
    openrouter_replacements = contents.count(legacy_openrouter_setting)
    legacy_database_settings = (
        f"database_url: {DEFAULT_DATABASE_URL}",
        f"database_url: {LEGACY_DATABASE_URL}",
    )
    database_replacements = sum(
        contents.count(setting) for setting in legacy_database_settings
    )
    redis_replacements = contents.count(LEGACY_REDIS_BLOCK)
    if (
        openrouter_replacements == 0
        and database_replacements == 0
        and redis_replacements == 0
    ):
        return 0

    updated = contents.replace(
        legacy_openrouter_setting,
        f"api_key: {OPENROUTER_API_KEY_ENV_REF}",
    )
    for legacy_database_setting in legacy_database_settings:
        updated = updated.replace(
            legacy_database_setting,
            f"database_url: {DATABASE_URL_ENV_REF}",
        )
    updated = updated.replace(LEGACY_REDIS_BLOCK, ACTIVE_REDIS_BLOCK)
    temporary_file = CONFIG_FILE.with_suffix(".yaml.tmp")
    temporary_file.write_text(updated, encoding="utf-8")
    temporary_file.chmod(CONFIG_FILE.stat().st_mode & 0o777)
    temporary_file.replace(CONFIG_FILE)
    if openrouter_replacements:
        print(
            f"Migrated {openrouter_replacements} legacy OpenRouter API key "
            f"placeholder(s) in {CONFIG_FILE}.",
            flush=True,
        )
    if database_replacements:
        print(
            f"Migrated {database_replacements} bundled database URL "
            f"setting(s) in {CONFIG_FILE}.",
            flush=True,
        )
    if redis_replacements:
        print(
            f"Enabled the default Redis cache in {CONFIG_FILE}.",
            flush=True,
        )
    return openrouter_replacements + database_replacements + redis_replacements


def main() -> int:
    """Copy default config if needed, then exec LiteLLM."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy(BUNDLED_CONFIG, CONFIG_FILE)
        print(
            f"Default configuration written to {CONFIG_FILE}.\n"
            "Edit the file to set master_key, api keys, and other settings,\n"
            "then restart the add-on.",
            file=sys.stderr,
            flush=True,
        )
        return 1

    migrate_legacy_config()
    configure_environment()
    python_path = os.environ.get("PYTHONPATH", "")
    os.environ["PYTHONPATH"] = f"{GUARDRAIL_DIR}:{python_path}".rstrip(":")
    print(f"Starting LiteLLM with configuration: {CONFIG_FILE}", flush=True)
    os.execvp("litellm", [
        "litellm",
        "--config", str(CONFIG_FILE),
        "--host", "0.0.0.0",
        "--port", "4000",
    ])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
