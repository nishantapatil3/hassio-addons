#!/usr/bin/env python3
"""Start LiteLLM proxy from a user-provided configuration file."""

from __future__ import annotations

import json
import os
from pathlib import Path
import secrets
import sys

DATA_DIR = Path(os.environ.get("LITELLM_ADDON_DATA", "/data"))
CONFIG_DIR = Path(os.environ.get("LITELLM_ADDON_CONFIG", "/config"))
CONFIG_FILE = CONFIG_DIR / "litellm.yaml"
SALT_KEY_PATH = DATA_DIR / "salt_key"
GUARDRAIL_DIR = Path("/usr/local/lib/litellm-addon")
OPTIONS_FILE = DATA_DIR / "options.json"

# Maps HA add-on option names → LiteLLM / compose environment variable names.
OPTION_ENV_MAP = {
    "master_key":        "LITELLM_MASTER_KEY",
    "openrouter_api_key": "OPENROUTER_API_KEY",
    "nvidia_api_key":    "NVIDIA_NIM_API_KEY",
    "database_url":      "DATABASE_URL",
    "redis_url":         "REDIS_URL",
    "searxng_api_base":  "SEARXNG_API_BASE",
    "server_root_path":  "SERVER_ROOT_PATH",
    "log_level":         "LITELLM_LOG",
}

DEFAULT_CONFIG = """\
# LiteLLM proxy configuration
# Edit this file and restart the app to apply changes.
# Full reference: https://docs.litellm.ai/docs/proxy/configs
#
# Sensitive values are read from the add-on options panel and injected as
# environment variables. You can also hardcode them here directly.

model_list:
  # ============================================================
  # Claude Code models — Claude model names mapped to free NVIDIA
  # NIM models via OpenRouter. Replace with any supported backend.
  # ============================================================
  - model_name: claude-haiku-4-5-20251001
    litellm_params:
      model: openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
      api_key: os.environ/OPENROUTER_API_KEY
    model_info:
      supports_function_calling: true
      supports_web_search: true
      supports_vision: false
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0

  - model_name: claude-sonnet-4-6
    litellm_params:
      model: openrouter/nvidia/nemotron-3-super-120b-a12b:free
      api_key: os.environ/OPENROUTER_API_KEY
    model_info:
      supports_function_calling: true
      supports_web_search: true
      supports_vision: false
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0

  - model_name: claude-opus-4-8
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
      api_key: os.environ/OPENROUTER_API_KEY
    model_info:
      supports_function_calling: true
      supports_web_search: true
      supports_vision: false
      cache_creation_input_token_cost: 0
      cache_read_input_token_cost: 0

  # ============================================================
  # NVIDIA NIM direct — set nvidia_api_key in add-on options,
  # then uncomment to use NIM endpoints directly.
  # ============================================================
  # - model_name: nemotron-3-ultra-550b-a55b
  #   litellm_params:
  #     model: nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b
  #     api_key: os.environ/NVIDIA_NIM_API_KEY
  #   model_info:
  #     supports_function_calling: true
  #     supports_web_search: true
  #     supports_vision: false
  #     cache_creation_input_token_cost: 0
  #     cache_read_input_token_cost: 0

litellm_settings:
  drop_params: true
  modify_params: true
  set_verbose: false
  global_max_parallel_requests: 100
  allowed_fails: 5
  cooldown_time: 600
  callbacks:
    - prometheus
  # To enable SearXNG web-search interception, set searxng_api_base in
  # add-on options and replace the callbacks block with the one below.
  # callbacks:
  #   - websearch_interception
  #   - prometheus
  # websearch_interception_params:
  #   search_tool_name: searxng-search
  #   enabled_providers:
  #     - openrouter
  #     - anthropic
  #     - openai
  prometheus_initialize_budget_metrics: true
  prometheus_emit_stream_label: true
  require_auth_for_metrics_endpoint: false
  # To enable Redis response caching, set redis_url in add-on options
  # and uncomment the block below.
  # cache: true
  # cache_params:
  #   type: redis
  #   namespace: litellm-cache
  #   ttl: 600

router_settings:
  fallbacks:
    - claude-opus-4-8:
        - claude-sonnet-4-6
    - claude-sonnet-4-6:
        - claude-haiku-4-5-20251001

# To enable SearXNG web-search tool calls, set searxng_api_base in add-on
# options and uncomment this section (also update callbacks above).
# search_tools:
#   - search_tool_name: searxng-search
#     litellm_params:
#       search_provider: searxng
#       api_base: os.environ/SEARXNG_API_BASE

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  # To enable the admin UI, virtual keys, and spend tracking, set database_url
  # in add-on options (requires a PostgreSQL instance — see add-on docs).
  # database_url: os.environ/DATABASE_URL
  # store_model_in_db: true
  store_prompts_in_spend_logs: true
  use_x_forwarded_for: true
  enforce_user_param: false
  fail_closed_budget_enforcement: true
  reject_clientside_metadata_tags: true

guardrails:
  - guardrail_name: no-file-input
    litellm_params:
      guardrail: no_file_input_guardrail.NoFileInputGuardrail
      mode: pre_call
      default_on: true
"""


def get_salt_key() -> str:
    """Create a stable per-installation salt key if one does not exist."""
    if SALT_KEY_PATH.exists():
        return SALT_KEY_PATH.read_text(encoding="utf-8").strip()
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    salt_key = f"sk-salt-{secrets.token_hex(32)}"
    SALT_KEY_PATH.write_text(f"{salt_key}\n", encoding="utf-8")
    SALT_KEY_PATH.chmod(0o600)
    return salt_key


def apply_options() -> None:
    """Read add-on options from /data/options.json and inject as env vars."""
    if not OPTIONS_FILE.exists():
        return
    opts: dict = json.loads(OPTIONS_FILE.read_text(encoding="utf-8"))
    for key, envvar in OPTION_ENV_MAP.items():
        val = opts.get(key)
        if val is not None and str(val).strip():
            os.environ.setdefault(envvar, str(val).strip())


def configure_environment() -> None:
    """Inject add-on options as env vars and set the auto-generated salt key."""
    apply_options()
    os.environ["LITELLM_SALT_KEY"] = get_salt_key()


def main() -> int:
    """Write default config if needed, then exec LiteLLM."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(DEFAULT_CONFIG, encoding="utf-8")
        print(
            f"Default configuration written to {CONFIG_FILE}.\n"
            "Set master_key and openrouter_api_key in the add-on options panel,\n"
            "then restart the app.",
            file=sys.stderr,
            flush=True,
        )
        return 1

    configure_environment()
    python_path = os.environ.get("PYTHONPATH", "")
    os.environ["PYTHONPATH"] = f"{GUARDRAIL_DIR}:{python_path}".rstrip(":")
    print(f"Starting LiteLLM with configuration: {CONFIG_FILE}", flush=True)
    os.execvp("litellm", [
        "litellm",
        "--config", str(CONFIG_FILE),
        "--host", "0.0.0.0",
        "--port", "4000",
    ])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
